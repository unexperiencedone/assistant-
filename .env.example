# Secrets for Nova. Copy to `.env` and fill in. `.env` is git-ignored; this file is not,
# so it must never hold a real value.
#
# Nothing here is required to run Nova. Each block switches on one capability, and the
# business pipeline (docs/business_pipeline.md) refuses to start a stage whose keys are
# missing rather than failing halfway through it — `python main.py business preflight`
# lists exactly what is absent and what it would unlock.

# ---------------------------------------------------------------------------- brains
# Free tiers. Claude work goes through the `claude` CLI session, never an API key:
# there is no Anthropic billing on this machine and nothing here should add one.
OPENROUTER_API_KEY=
GROQ_API_KEY=

# ----------------------------------------------------------------------------- phone
# The Termux bridge's shared secret (phone/README.md). Printed by the bridge on the
# phone with `python nova_bridge.py --print-token`.
NOVA_PHONE_TOKEN=

# ------------------------------------------------------------------------- publishing
# The social arms (docs/publishing.md). Nothing here can post by itself: every draft
# goes through the approval gate and waits for you to say so out loud.

# LinkedIn. An app in the developer portal with the self-serve "Share on LinkedIn"
# product attached gives the w_member_social scope, which is exactly "act as the member
# who signed in, on their own feed". No partner programme and no review conversation.
# The token expires after 60 days (its refresh token after 365), which is why an
# expired one has to read as "sign in again" rather than as a mysterious failure.
LINKEDIN_ACCESS_TOKEN=

# Instagram, through the Content Publishing API. Two things the internet overstates:
# you do NOT need App Review to publish to your own account (add it as an Instagram
# Tester and work in development mode), but you DO need a professional account --
# Business or Creator, and Reels needs Business specifically. A personal account cannot
# publish through the API at all, and that is an account setting, not a code problem.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# Not implemented yet, so deliberately absent rather than listed empty:
#   * Gmail. Planned as stdlib smtplib/imaplib with an app password, which needs 2FA on
#     the account first. No variable names are fixed until the arm exists.
#   * Two identities. Nova is to hold its own accounts and act as a proxy on yours,
#     which the one-token-per-platform shape above cannot express. Filling a single
#     LinkedIn token in now posts as whoever that token belongs to, and nothing more.
#     See the "Designed, not built" section of docs/publishing.md before restructuring.

# ------------------------------------------------------------------------ prospecting
# Where a list of possible customers comes from. Google Places bills per request and
# has a free monthly credit; it returns business name, address, phone, website and
# rating, which is enough to tell who has no website worth having.
GOOGLE_PLACES_API_KEY=
# Optional: finds a role address (hello@, contact@) for a domain, so outreach goes to a
# mailbox somebody reads rather than a guess.
HUNTER_API_KEY=

# ----------------------------------------------------------------------------- email
# Resend is the least setup; any SMTP host works instead by filling the SMTP block.
RESEND_API_KEY=
# The address mail comes FROM. It must be on a domain you control and have verified
# with the provider, or everything lands in spam.
OUTREACH_FROM_EMAIL=
OUTREACH_FROM_NAME=
# Where replies go, if different. Point this at a mailbox you actually watch.
OUTREACH_REPLY_TO=
# Postal address for the unsubscribe footer. Not optional in practice: bulk mail
# without a real sender identity and a working opt-out is what gets a domain blocked.
OUTREACH_POSTAL_ADDRESS=

# SMTP instead of Resend (leave RESEND_API_KEY empty to use these)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# -------------------------------------------------------------------------- whatsapp
# Meta's WhatsApp Cloud API — the only route that does not get a number banned. Read
# the "WhatsApp is not email" section of docs/business_pipeline.md before filling this
# in: outside a 24-hour window opened by the customer, you may send only templates Meta
# approved in advance, and a cold first message is not one of them.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Your own random string; Meta echoes it back when it verifies your webhook URL.
WHATSAPP_VERIFY_TOKEN=
# Used to check that an inbound webhook really came from Meta.
WHATSAPP_APP_SECRET=

# ---------------------------------------------------------------------------- hosting
# Where a finished site is published. Cloudflare Pages is the default: free tier, an
# API that creates a project and deploys in one call, and the same account can hold the
# domain, so handover is one transfer rather than three.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Alternatives, if you would rather not put everything in one account.
NETLIFY_AUTH_TOKEN=
VERCEL_TOKEN=

# ---------------------------------------------------------------------------- domains
# Registering on the customer's behalf costs real money on a real card, so the pipeline
# always stops and asks before it buys one, whatever else it has been told to do.
# Porkbun and Namecheap both have an API; Namecheap requires whitelisting your IP.
PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=

# --------------------------------------------------------------------------- payments
# For invoicing a customer who says yes. Razorpay for India, Stripe elsewhere.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
